# Copy to application.properties to override settings from application.yml locally.
# MariaDB in XAMPP; use the real credentials on your machine.
spring.datasource.url=jdbc:mariadb://127.0.0.1:3306/quan_ly_sinh_vien
spring.datasource.username=root
spring.datasource.password=
# Environment alternatives: DB_URL, DB_USERNAME, DB_PASSWORD.
# Development administrator: ADMIN_USERNAME, ADMIN_PASSWORD.
# Disable sample records with DEMO_ENABLED=false.
# File storage: MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY, MINIO_BUCKET.
# Upload limits: MAX_FILE_SIZE (20MB) and MAX_REQUEST_SIZE (50MB).
